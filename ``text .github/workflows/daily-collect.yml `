name: 每日自动采集金融监管处罚

on:
  schedule:
    # 每天北京时间 08:00 自动运行（UTC 00:00）
    - cron: '0 0 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  collect-and-update:
    runs-on: ubuntu-latest
    steps:
      - name: 拉取仓库代码
        uses: actions/checkout@v4

      - name: 配置 Python 环境
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: 运行专项处罚自动采集脚本
        run: python collector.py

      - name: 提交最新处罚数据
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add penalties-data.json
          if git diff --cached --quiet; then
            echo "今日暂无数据变化"
          else
            git commit -m "chore: 每日自动更新金融监管处罚数据"
            git push
          fi
